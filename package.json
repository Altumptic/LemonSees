{
  "name": "lemonsees",
  "version": "3.1.0",
  "description": "LemonSees by Altumptic — agentless SOC platform over SSH: SIEM, EDR, FIM, NDR, MITRE ATT&CK, SOAR, GRC, Wazuh/Datadog integrations, optional agents, proxy/Tor routing with kill switch and encrypted secrets. Web app or portable desktop app for Windows and Linux.",
  "author": {
    "name": "Altumptic",
    "email": "security@altumptic.com",
    "url": "https://altumptic.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Altumptic/LemonSees.git"
  },
  "homepage": "https://github.com/Altumptic/LemonSees#readme",
  "bugs": {
    "url": "https://github.com/Altumptic/LemonSees/issues"
  },
  "keywords": [
    "soc",
    "siem",
    "edr",
    "xdr",
    "ndr",
    "cti",
    "soar",
    "grc",
    "ssh",
    "security",
    "electron",
    "windows",
    "wazuh-alternative",
    "mitre-attack",
    "fim",
    "linux",
    "web",
    "portable",
    "tor",
    "socks5",
    "datadog",
    "privacy",
    "encryption"
  ],
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p .",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "start:web": "node server/index.js --no-open",
    "app": "electron .",
    "dist:win": "npm run build && electron-builder --win portable zip --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage tar.gz --publish never",
    "dist:dir": "npm run build && electron-builder --dir",
    "assets": "electron scripts/render.cjs icons",
    "shots": "electron scripts/render.cjs shots",
    "world-dots": "node scripts/world-dots.mjs",
    "test": "node --test \"test/**/*.test.js\"",
    "audit:prod": "npm audit --omit=dev --audit-level=critical"
  },
  "build": {
    "appId": "com.altumptic.lemonsees",
    "productName": "LemonSees",
    "copyright": "Copyright © 2026 Altumptic",
    "directories": {
      "buildResources": "buildResources",
      "output": "release"
    },
    "asar": false,
    "files": [
      "electron/**",
      "server/**",
      "dist/**",
      "package.json",
      "!**/*.map"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "buildResources/icon.png",
      "legalTrademarks": "LemonSees by Altumptic"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "buildResources/icon.png",
      "category": "Network",
      "maintainer": "Altumptic <security@altumptic.com>",
      "vendor": "Altumptic",
      "synopsis": "Agentless SOC platform",
      "executableName": "lemonsees"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.AppImage"
    }
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "express": "^4.21.2",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.575.0",
    "mongodb": "^7.7.0",
    "mysql2": "^3.23.1",
    "pg": "^8.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "selfsigned": "^2.4.1",
    "sql.js": "^1.14.1",
    "ssh2": "^1.16.0",
    "undici": "^6.29.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "d3-geo": "^3.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.2.1",
    "topojson-client": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "world-atlas": "^2.0.2"
  },
  "overrides": {
    "qs": "^6.16.2"
  }
}
